# ─────────────────────────────────────────────
# 클라이언트(브라우저)용 Firebase 웹 앱 설정
# Firebase 콘솔 → 프로젝트 설정 → 내 앱 → 웹 앱의 firebaseConfig 값을 넣는다.
# (이 값들은 공개되어도 되는 식별자다. 실제 보호는 보안 규칙이 담당한다.)
# ─────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# 화면에서 접근을 허용할 관리자 이메일 (쉼표로 구분)
VITE_ADMIN_EMAILS=higidia@gmail.com

# ─────────────────────────────────────────────
# 서버(Netlify Functions) 전용 — Netlify 환경변수에만 저장한다.
# 절대 VITE_ 접두사를 붙이지 않는다(붙이면 브라우저에 노출됨).
# ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=
NEWS_API_KEY=
FIREBASE_SERVICE_ACCOUNT=
ADMIN_EMAILS=higidia@gmail.com
